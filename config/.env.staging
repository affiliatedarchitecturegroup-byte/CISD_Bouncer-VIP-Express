# Staging Environment Configuration
# DO NOT COMMIT TO VERSION CONTROL

NODE_ENV=staging
PORT=3000

# Database
DB_HOST=staging-db.internal
DB_PORT=5432
DB_NAME=bouncer_express_staging
DB_USER=bouncer
DB_PASSWORD=

# MongoDB
MONGO_URI=mongodb://staging-mongo.internal:27017/bouncer_staging

# Redis
REDIS_HOST=staging-redis.internal
REDIS_PORT=6379

# JWT
JWT_SECRET=
JWT_EXPIRY=24h

# External Services
STRIPE_API_KEY=
SENDGRID_API_KEY=

# Features
ENABLE_DEBUG=false
ENABLE_METRICS=true
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=1000

# Monitoring
DATADOG_API_KEY=