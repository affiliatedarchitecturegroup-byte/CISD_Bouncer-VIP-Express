# Development Environment Configuration
# DO NOT COMMIT TO VERSION CONTROL

NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bouncer_express_dev
DB_USER=bouncer
DB_PASSWORD=dev_password

# MongoDB
MONGO_URI=mongodb://localhost:27017/bouncer_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=dev_jwt_secret_key_change_in_production
JWT_EXPIRY=24h

# External Services
STRIPE_API_KEY=sk_test_xxx
SENDGRID_API_KEY=sgkey_xxx

# Features
ENABLE_DEBUG=true
ENABLE_METRICS=true
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100