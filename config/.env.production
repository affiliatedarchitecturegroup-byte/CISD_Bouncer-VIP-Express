# Production Environment Configuration
# DO NOT COMMIT TO VERSION CONTROL

NODE_ENV=production
PORT=3000

# Database
DB_HOST=prod-db.internal
DB_PORT=5432
DB_NAME=bouncer_express_production
DB_USER=bouncer
DB_PASSWORD=

# MongoDB
MONGO_URI=mongodb://prod-mongo.internal:27017/bouncer_production

# Redis
REDIS_HOST=prod-redis.internal
REDIS_PORT=6379

# JWT
JWT_SECRET=
JWT_EXPIRY=12h

# External Services
STRIPE_API_KEY=
SENDGRID_API_KEY=

# Features
ENABLE_DEBUG=false
ENABLE_METRICS=true
LOG_LEVEL=warn

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=10000

# Monitoring
DATADOG_API_KEY=

# Security
CORS_ORIGINS=https://bouncervip.co.za,https://www.bouncervip.co.za
ALLOWED_IPS=

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30