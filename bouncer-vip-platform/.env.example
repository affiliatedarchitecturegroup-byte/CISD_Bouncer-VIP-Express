# Bouncer VIP Platform - Environment Template
# Copy this file to .env for each service and fill in values

# ===================
# Common
# ===================
NODE_ENV=development
LOG_LEVEL=debug

# ===================
# Database (PostgreSQL)
# ===================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bouncer_express
POSTGRES_USER=bouncer
POSTGRES_PASSWORD=change_this_password

# ===================
# Redis
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379

# ===================
# NATS
# ===================
NATS_HOST=localhost
NATS_PORT=4222

# ===================
# JWT (API Gateway, Guard App)
# ===================
JWT_SECRET=change_this_to_random_secret_key

# ===================
# Email (SMTP)
# ===================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password

# ===================
# SMS (Twilio)
# ===================
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_FROM=+1234567890

# ===================
# Smart Contracts (Polygon)
# ===================
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=your_private_key_without_0x

# ===================
# AI Services (Optional)
# ===================
OPENAI_API_KEY=sk-your-openai-key