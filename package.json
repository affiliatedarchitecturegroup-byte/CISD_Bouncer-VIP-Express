{
  "name": "bouncer-vip-express-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Bouncer VIP Express - Polyglot Microservices Platform",
  "workspaces": [
    "bouncer-vip-platform/services/*",
    "express-platform/services/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:bouncer\" \"npm run dev:express\"",
    "dev:bouncer": "npm run dev --workspaces --if-present",
    "dev:express": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:all": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run test --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint --workspaces --if-present -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v --rmi local",
    "k8s:deploy": "kubectl apply -f k8s/base/",
    "k8s:deploy:staging": "kubectl apply -k k8s/overlays/staging",
    "k8s:deploy:prod": "kubectl apply -k k8s/overlays/production",
    "k8s:status": "kubectl get pods -n bouncer-vip",
    "k8s:logs": "kubectl logs -n bouncer-vip -l app=bouncer-api-gateway",
    "lint-staged": "lint-staged",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.0.0"
}